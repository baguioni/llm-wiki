}

@misc{shumSWERMExecutionfreeFeedback2025,
  title = {{{SWE-RM}}: {{Execution}}-Free {{Feedback For Software Engineering Agents}}},
  shorttitle = {{{SWE-RM}}},
  author = {Shum, KaShun and Hui, Binyuan and Chen, Jiawei and Zhang, Lei and W, X. and Yang, Jiaxi and Huang, Yuzhen and Lin, Junyang and He, Junxian},
  year = 2025,
