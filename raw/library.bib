}

@misc{parkSpecEdgeScalableEdgeAssisted2025,
  title = {{{SpecEdge}}: {{Scalable Edge-Assisted Serving Framework}} for {{Interactive LLMs}}},
  shorttitle = {{{SpecEdge}}},
  author = {Park, Jinwoo and Cho, Seunggeun and Han, Dongsu},
