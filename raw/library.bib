@misc{liuWhenParallelDrafter2026,
  title = {When {{Parallel Drafter Meets Parallel Speculative Decoding}}},
  author = {Liu, Fuliang and Li, Xue and Qian, Kun and Wang, Zhibin and Dou, Wanchun and Yu, Wenyuan and Tian, Chen},
  year = 2026,
  month = sep,
  number = {arXiv:2609.27396},
  eprint = {2609.27396},
  primaryclass = {cs.CL},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2609.27396},
  urldate = {2026-10-05},
  abstract = {DSpark-style parallel drafters have made speculative decoding highly effective, yet their draft phase remains serialized on the critical path of every round. Parallel speculative decoding (PSD) overlaps drafting with verification, yet existing methods must guess the accepted prefix and bonus token in advance: a wrong guess reverts the whole batch to serial drafting. We present DPara, a PSD framework that reuses effective parallel drafters yet guarantees backbone--verification overlap in every round, thereby eliminating this probabilistic fallback altogether. While the target verifies, DPara's diffusion backbone precomputes draft representations for every acceptance boundary with the bonus left unspecified; a lightweight autoregressive head then combines the revealed verification outcome with the matching precomputed representation to emit the next round's draft tokens almost instantly---fully parallelizing the dominant backbone forward with verification and leaving only the negligible head cost serial. Experiments on Qwen3-8B and Qwen3-14B across seven math, coding, and chat benchmarks show that DPara achieves average speedups of \$3.21\textbackslash times\$ and \$3.52\textbackslash times\$ over autoregressive decoding, surpassing the strongest serial and parallel speculative decoding baselines alike.},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Computation and Language},
  groups = {scheduling},
  timestamp = {2026-10-05T17:50:30Z},
  file = {Full Text PDF:/Users/vafbaguio/Zotero/storage/4VXB6HX2/Liu et al. - 2026 - When Parallel Drafter Meets Parallel Speculative Decoding.pdf:application/pdf;Snapshot:/Users/vafbaguio/Zotero/storage/4MA6RVFE/2609.html:text/html}
}

@misc{liWebSailorV2BridgingChasm2025,
  title = {{{WebSailor-V2}}: {{Bridging}} the {{Chasm}} to {{Proprietary Agents}} via {{Synthetic Data}} and {{Scalable Reinforcement Learning}}},
  shorttitle = {{{WebSailor-V2}}},
  author = {Li, Kuan and Zhang, Zhongwang and Yin, Huifeng and Ye, Rui and Zhao, Yida and Zhang, Liwen and Ou, Litu and Zhang, Dingchu and Wu, Xixi and Wu, Jialong and Wang, Xinyu and Qiao, Zile and Zhang, Zhen and Jiang, Yong and Xie, Pengjun and Huang, Fei and Zhou, Jingren},
