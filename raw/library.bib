}

@misc{liEAGLE3ScalingInference2025,
  title = {{{EAGLE-3}}: {{Scaling}} up {{Inference Acceleration}} of {{Large Language Models}} via {{Training-Time Test}}},
  shorttitle = {{{EAGLE-3}}},
  author = {Li, Yuhui and Wei, Fangyun and Zhang, Chao and Zhang, Hongyang},
