@misc{weiSDFPSpeculativeDecoding2026,
  title = {{{SDFP}}: {{Speculative Decoding}} with {{FIT-Pruned Models}} for {{Training-Free}} and {{Plug}}-and-{{Play LLM Acceleration}}},
  shorttitle = {{{SDFP}}},
  author = {Wei, Hanyu and Su, Zunhai and Lu, Peng and Li, Chao and Tiwari, Spandan and Sirasao, Ashish and Dong, Yuhan},
